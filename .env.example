# ElevenLabs Conversational AI (leave blank to run in mock voice mode)
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=

# Who is on the call (used as a dynamic variable)
DEVPROD_DEVELOPER=developer

# Approval pushes a fix branch and opens a real PR (via `gh` if installed, otherwise a
# GitHub compare link). Set to 0 for a dry-run with a fake link.
DEVPROD_ENABLE_PR=1
# PR base branch; blank = the branch you are running the simulator from
DEVPROD_PR_BASE=
