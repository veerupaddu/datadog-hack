# ElevenLabs Conversational AI (leave blank to run in mock voice mode)
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=

# Who is on the call (used as a dynamic variable)
DEVPROD_DEVELOPER=developer

# Set to 1 to push a branch and open a real PR after approval (needs `git push` access;
# uses the `gh` CLI if installed, otherwise links to the GitHub compare page)
DEVPROD_ENABLE_PR=0
# PR base branch; blank = the branch you are running the simulator from
DEVPROD_PR_BASE=
